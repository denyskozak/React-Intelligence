  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "dependencies": {
    "@react-intelligence/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "typescript": "^5.7.2"
  }
}
