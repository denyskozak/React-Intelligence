{
  "name": "@react-intelligence/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist", "!dist/**/*.test.js"],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "smoke:sdk": "tsx --test src/sdkE2e.test.ts",
    "start": "node dist/index.js",
    "seed": "tsx src/scripts/seed.ts",
    "db:backup": "tsx src/scripts/backup.ts",
    "db:restore": "tsx src/scripts/restore.ts",
    "db:migrations": "tsx src/scripts/migrationStatus.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@jridgewell/trace-mapping": "^0.3.29",
    "@react-intelligence/shared": "workspace:*",
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.11.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@react-intelligence/sdk": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "happy-dom": "^18.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
